# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to version control.

# ---- Roboflow ----
ROBOFLOW_API_KEY=YOUR_ROBOFLOW_API_KEY
ROBOFLOW_MODEL_ID=coco/50
ROBOFLOW_API_URL=https://serverless.roboflow.com

# ---- Camera source ----
# "esp32"  = read video from the ESP32-CAM over WiFi (target hardware)
# "laptop" = read video from the PC's own webcam (use this if the ESP32-CAM
#            can't be powered yet — everything else in the pipeline is identical)
CAMERA_SOURCE=laptop
LAPTOP_CAM_INDEX=0

# ---- ESP32-CAM (only used when CAMERA_SOURCE=esp32) ----
ESP32_STREAM_URL=http://YOUR_ESP32_IP:81/stream

# ---- Arduino ----
ARDUINO_PORT=COM3
ARDUINO_BAUDRATE=9600

# ---- Detection tuning ----
CONFIDENCE_THRESHOLD=0.50
INFERENCE_FPS=3
FRAME_RESIZE_WIDTH=640

# ---- Risk model ----
DISTANCE_CRITICAL_MAX=30
DISTANCE_HIGH_MAX=60
DISTANCE_MEDIUM_MAX=100
DISTANCE_RISK_RANGE_CM=200
RISK_WEIGHT_OBJECT=0.20
RISK_WEIGHT_DISTANCE=0.20
RISK_WEIGHT_PATH=0.15
RISK_WEIGHT_OBSTRUCTION=0.15
RISK_WEIGHT_SPEED=0.10
RISK_WEIGHT_TTC=0.10
RISK_WEIGHT_SIZE=0.10
RISK_WATCH_THRESHOLD=0.30
RISK_WARNING_THRESHOLD=0.50
RISK_HIGH_THRESHOLD=0.70
RISK_CRITICAL_THRESHOLD=0.85
OBJECT_RISK_SCORES=chair:0.30,table:0.35,stairs:0.75,car:0.95,truck:1.0,bus:1.0
TTC_RISK_HORIZON_SEC=5
BOX_AREA_RISK_MAX=0.35
TRACK_MAX_GAP_SEC=2
TRACK_CENTER_TOLERANCE=0.25
PATH_CORRIDOR_HALF_WIDTH=0.20
PATH_LATERAL_MOTION_DELTA=0.04
PATH_SUDDEN_ENTRY_SPEED=0.30
HIGH_HAZARD_RELEVANCE_DISTANCE_CM=300
BLOCKING_DISTANCE_CM=120
BLOCKING_CORRIDOR_COVERAGE_MIN=0.35
RISK_NON_PATH_MAX_SCORE=0.25
# Approximate monocular estimate for boxes not paired with the single HC-SR04.
CAMERA_REFERENCE_DISTANCE_CM=70
CAMERA_REFERENCE_HEIGHT_RATIO=0.35
CAMERA_DISTANCE_MIN_CM=20
CAMERA_DISTANCE_MAX_CM=500

# ---- Voice ----
VOICE_COOLDOWN=3
VOICE_DISTANCE_DELTA=15
# Only HIGH/CRITICAL warnings are spoken.
VOICE_MIN_RISK=HIGH
# "Coming closer" detection:
NEAR_DISTANCE_MAX=100
APPROACH_WINDOW_SEC=1.5
APPROACH_MIN_CHANGE_CM=5
FAST_APPROACH_CM_PER_SEC=35
URGENT_TTC_SEC=2
RISK_CHANGE_REANNOUNCE_DELTA=0.15
DETECTION_STALE_SEC=2
ULTRASONIC_CENTER_TOLERANCE=0.35
VOICE_RATE=165
VOICE_ENABLED=true

# ---- Flask ----
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# ---- Test mode ----
# When true, the app runs entirely without ESP32-CAM / Arduino / Roboflow,
# using simulated camera frames, distance readings, and detections.
TEST_MODE=false

# ---- Optional Gemini conversational agent ----
# Add your Gemini API key to enable general conversation.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Set this to a Gemini model available to your API account.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_HISTORY_LIMIT=8

# ---- Optional voice wake word ----
# Safety alerts NEVER depend on this setting. The existing risk engine
# continues to alert automatically. The wake word is only for conversation.
WAKEWORD_ENABLED=true
WAKEWORD_MODEL=hey_jarvis
WAKEWORD_THRESHOLD=0.55
COMMAND_SECONDS=5
WAKEWORD_TEMP_WAV=logs/voice_command.wav
